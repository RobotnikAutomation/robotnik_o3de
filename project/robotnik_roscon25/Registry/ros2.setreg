{
    "O3DE":
    {
        "InputSystem":
        {
            "Mouse":
            {
                "CaptureMouseCursor": false
            }
        },
        "ROS2":
        {
            // Do not rely on the ROS2 Gem default: realtime clock would make
            // the benchmark RTF look close to 1 even if Physics slowed down.
            "ClockType" : "simulation",
            "PublishClock" : true,
            "SteadyClock" : true,
            "Camera":
            {
                "AllowPipelineModification": false
            }
        }
    }
}
